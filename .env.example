# Copy to .env and fill in. .env is gitignored; this file is not.
# EXAMPLE_API_KEY=
# LOG_LEVEL=info

# Where the errors-only log file lands on this machine (README, "Logs").
# Default is the checkout's own logs/ directory. To move it, name a directory
# the container's uid 1000 can write (e.g. after `sudo mkdir -p
# /var/log/minibadge && sudo chown 1000 /var/log/minibadge`):
# LOG_DIR=/var/log/minibadge

# A request slower than this many seconds is logged as a WARNING even when it
# succeeds, so addresses that keep sending the heaviest possible boards show
# up in errors.log. Default 20.
# SLOW_REQUEST_S=20
