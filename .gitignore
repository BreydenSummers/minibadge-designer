.env
*.env
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
.Python
*.so
.venv/
venv/
dist/
build/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# Coverage: `pytest --cov` drops .coverage in the repo root, and without
# these entries the first thing the new test tooling does is dirty `git status`.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local data and output: may contain sensitive findings
data/
output/
results/
*.sqlite
*.sqlite3
*.db
*.log

# Keep empty directory structure
!**/.gitkeep

# Docker
*.pid

# AI assistant tooling: local to a developer, not part of the project
.claude/
.cursor/
.aider*
.continue/
.github/copilot-instructions.md
CLAUDE.md
AGENTS.md
GEMINI.md
.mcp.json

# Third-party assets, fetched by scripts/fetch_assets.py.
# Other people's files under other people's licences: downloaded on setup,
# never committed here. See that script for versions, checksums, and terms.
minibadge_designer/fonts/*.ttf
minibadge_designer/fonts/THIRD-PARTY-NOTICE.txt
minibadge_designer/static/vendor/

# Generated KiCad reports: deliberately NOT ignored any more.
#
# A blanket `*.rpt` used to live here, and it made a stray DRC report in the
# tracked tree invisible to `git status` forever; `helmet-drc.rpt` sat in the
# repo root unnoticed because of it. Reports belong in the test's tmp_path or
# in output/ (already ignored above); one landing beside the source is a bug
# and should be *visible* so it gets noticed and deleted. tests/conftest.py
# enforces the same rule from the other side, by failing any test that writes
# into the repo root.
