.env
*.env
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
.Python
*.so
.venv/
venv/
dist/
build/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
